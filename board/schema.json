{
  "amendable_fields": {
    "fields": [
      "assignee_instance",
      "assignee_kind",
      "body",
      "depends_on",
      "wait"
    ],
    "note": "FR-K4: the fields an amendment event may change, exactly. verdict_ref changes only by superseding attachment (FR-K1a); any other field change is a supersede-and-replace of the row. Read by board/kernel.py (the guard) and board/fold.py (applying an amendment that sets a previously absent field, e.g. body)."
  },
  "caller_event_fields": {
    "fields": [
      "event_id",
      "board_id",
      "row_id",
      "actor",
      "kind",
      "payload"
    ],
    "note": "Fields a caller supplies to the append command. writer, prev_hash and event_hash are never caller-supplied: the append service stamps writer and computes the hashes under the lock."
  },
  "description": "Pinned schema for the Agent Board (spec AB-001 as amended, Sections 3.1 and 3.2). Validated by board/validate.py; refusals are named per field.",
  "event_fields": {
    "actor": {
      "required": true,
      "type": "string"
    },
    "board_id": {
      "required": true,
      "type": "string"
    },
    "event_hash": {
      "required": true,
      "type": "sha256_hex"
    },
    "event_id": {
      "required": true,
      "type": "string"
    },
    "kind": {
      "required": true,
      "type": "string"
    },
    "payload": {
      "required": true,
      "type": "object"
    },
    "prev_hash": {
      "required": true,
      "type": "sha256_hex"
    },
    "row_id": {
      "required": true,
      "type": "string_or_null"
    },
    "writer": {
      "required": true,
      "stamped_by": "append_service",
      "type": "string"
    }
  },
  "execution_state_enum": [
    "none",
    "queued",
    "running",
    "wrapper_complete",
    "failed_transport"
  ],
  "genesis_fields": {
    "board_id": {
      "required": true,
      "type": "string"
    },
    "detector_chat": {
      "required": true,
      "type": "string"
    },
    "escalation_target_2": {
      "required": true,
      "type": "string"
    },
    "keeper_cadence": {
      "required": true,
      "type": "string"
    },
    "program": {
      "required": true,
      "type": "string"
    },
    "spec_hash": {
      "required": true,
      "type": "sha256_hex"
    },
    "spec_ref": {
      "required": true,
      "type": "string"
    },
    "wip_limit": {
      "required": true,
      "type": "integer"
    }
  },
  "row_creation_payload_fields": {
    "fields": [
      "row_id",
      "task_ref",
      "status",
      "depends_on",
      "assignee_kind",
      "assignee_instance",
      "claim_ids",
      "execution_state",
      "verdict_ref",
      "wait",
      "body",
      "resumption_note",
      "blocker_note",
      "recovered_from",
      "gate_row"
    ],
    "note": "Fields a row_created payload may carry. Fold-derived fields (amendment_seq, created_event, last_event) are never payload fields; the fold sets them. recovered_from cites the original event_id when the row is re-appended by fork recovery (FR-S3a). gate_row (boolean, payload-only) declares a gate row for the kernel's assignment rule (FR-K5): a gate row takes a named assignee_instance, and the fold refuses a kind assignee for it; the fold records gate rows in its state, not as a row field."
  },
  "verdict_attachment_payload_fields": {
    "fields": [
      "verdict_ref",
      "previous_ref",
      "reason",
      "verdict_evaluation"
    ],
    "note": "Fields a verdict_attached payload may carry (FR-K1a). verdict_ref is the caller's; verdict_evaluation is stamped by the append service at attachment time (board/verdicts.py) and is never caller-supplied."
  },
  "row_fields": {
    "amendment_seq": {
      "derived": true,
      "required": true,
      "type": "integer"
    },
    "assignee_instance": {
      "required": true,
      "type": "string_or_null"
    },
    "assignee_kind": {
      "required": true,
      "type": "string_or_null"
    },
    "blocker_note": {
      "required": false,
      "type": "string"
    },
    "board_id": {
      "required": true,
      "type": "string"
    },
    "body": {
      "required": false,
      "type": "string"
    },
    "claim_ids": {
      "required": true,
      "type": "list_of_string"
    },
    "created_event": {
      "required": true,
      "type": "string"
    },
    "depends_on": {
      "required": true,
      "type": "list_of_string"
    },
    "execution_state": {
      "required": true,
      "type": "execution_state_enum"
    },
    "last_event": {
      "required": true,
      "type": "string"
    },
    "program": {
      "required": true,
      "type": "string"
    },
    "resumption_note": {
      "required": false,
      "type": "string"
    },
    "row_id": {
      "required": true,
      "type": "string"
    },
    "spec_hash": {
      "required": true,
      "type": "string"
    },
    "spec_ref": {
      "required": true,
      "type": "string"
    },
    "status": {
      "required": true,
      "type": "status_enum"
    },
    "task_ref": {
      "required": true,
      "type": "string"
    },
    "verdict_ref": {
      "required": true,
      "type": "string_or_null"
    },
    "wait": {
      "required": true,
      "type": "wait_or_null"
    }
  },
  "schema": "aee-board/1",
  "status_enum": [
    "proposed",
    "planned",
    "ready",
    "in_progress",
    "blocked",
    "in_review",
    "done",
    "withdrawn",
    "superseded"
  ],
  "wait_fields": {
    "escalation": {
      "required": true,
      "type": "string"
    },
    "match": {
      "required": false,
      "type": "object"
    },
    "prose_condition": {
      "required": false,
      "type": "string_or_null"
    },
    "sweep_deadline": {
      "required": true,
      "type": "string"
    },
    "wait_kind": {
      "required": true,
      "type": "wait_kind_enum"
    },
    "wake_falsifier": {
      "required": true,
      "type": "object"
    }
  },
  "wait_kind_enum": [
    "dependency",
    "named_event",
    "external_prose"
  ]
}
