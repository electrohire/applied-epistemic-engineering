{"ledger_type":"lifecycle","ledger_type_rule":"Lifecycle records are append-only delivery facts. Corrections are new records carrying correction_of; an existing record is never edited in place.","record_types":{"delivery":{"fields":[{"enum":["delivery"],"name":"record_type","required":true,"type":"string"},{"name":"delivery_id","provenance":"stable ID minted at delivery; never reused","required":true,"type":"string"},{"name":"repo","provenance":"repository that received the delivery","required":true,"type":"string"},{"name":"task_ref","provenance":"issue, task, or delivery reference supplied when work was commissioned","required":true,"type":"string"},{"enum":["unstructured","spec_kit_only","speckit_aee_preexisting_verifier","speckit_aee_authored","executable_only","full_ceremony_executable","prose_only_reference","full_ceremony"],"name":"governance_tag","required":true,"type":"string"},{"name":"tokens_total","provenance":"all inference charged to the delivery, including retries and verification","required":true,"type":"integer"},{"keys":["constitution","specify","spec","plan","tasks","implement","verify","review","repair"],"name":"tokens_by_phase","required":true,"type":"object"},{"keys":["authoring","spec_review","code_review","repair","adjudication"],"name":"human_minutes_by_activity","required":true,"type":"object"},{"name":"estimated","provenance":"true when token or human-minute values include declared estimates","required":true,"type":"boolean"},{"name":"attempts","required":true,"type":"integer"},{"name":"review_rounds","required":true,"type":"integer"},{"name":"accepted","required":true,"type":"boolean"},{"enum":["test","human_oracle","none"],"name":"acceptance_mode","required":true,"type":"string"},{"name":"accepted_at","provenance":"ISO timestamp when accepted; null only while unaccepted","required":true,"type":"string or null"},{"enum":["preexisting","authored_for_task","none"],"name":"verifier_provenance","required":true,"type":"string"},{"keys":["tokens","human_minutes"],"name":"verifier_production_cost","provenance":"required when verifier_provenance is authored_for_task; otherwise null","required":true,"type":"object or null"},{"name":"ceiling_tokens","required":true,"type":"integer or null"},{"name":"censored","required":true,"type":"boolean"},{"name":"capture_source","provenance":"the harness, hook, ledger, or reconstruction process that supplied this record","required":true,"type":"string"},{"name":"reconstructed","provenance":"true when any part was independently reconstructed under Amendment B-6","required":true,"type":"boolean"},{"item_required":["horizon_days","snapshot_at","lines_handwritten","lines_modified_or_deleted","standing"],"name":"survival","required":true,"type":"array of objects"},{"item_required":["horizon_days","outcome","cost_tokens","cost_human_minutes"],"name":"integration_probes","required":true,"type":"array of objects"},{"name":"linked_rework_ids","required":true,"type":"array of strings"},{"name":"linked_escape_ids","required":true,"type":"array of strings"},{"name":"correction_of","required":false,"type":"string"},{"name":"description","required":false,"type":"string"}],"id_field":"delivery_id"},"escape":{"fields":[{"enum":["escape"],"name":"record_type","required":true,"type":"string"},{"name":"escape_id","required":true,"type":"string"},{"name":"delivery_id","provenance":"the introducing delivery","required":true,"type":"string"},{"enum":["low","medium","high","critical"],"name":"severity","required":true,"type":"string"},{"name":"detected_at","required":true,"type":"string"},{"name":"time_to_detect_hours","required":true,"type":"number"},{"keys":["tokens","human_minutes"],"name":"repair_cost","required":true,"type":"object"},{"enum":["routine_surveillance","study_audit"],"name":"discovery_route","required":true,"type":"string"},{"name":"description","required":true,"type":"string"},{"name":"capture_source","required":true,"type":"string"},{"name":"reconstructed","required":true,"type":"boolean"},{"name":"estimated","required":true,"type":"boolean"},{"name":"correction_of","required":false,"type":"string"}],"id_field":"escape_id"},"rework":{"fields":[{"enum":["rework"],"name":"record_type","required":true,"type":"string"},{"name":"rework_id","required":true,"type":"string"},{"name":"delivery_id","provenance":"the introducing delivery","required":true,"type":"string"},{"enum":["SPEC","PLAN","IMPLEMENTATION","INTEGRATION","EXTERNAL"],"name":"origin_phase","required":true,"type":"string"},{"name":"detected_at","required":true,"type":"string"},{"name":"repair_tokens","required":true,"type":"integer"},{"name":"repair_human_minutes","required":true,"type":"number"},{"name":"description","required":true,"type":"string"},{"name":"capture_source","required":true,"type":"string"},{"name":"reconstructed","required":true,"type":"boolean"},{"name":"estimated","required":true,"type":"boolean"},{"name":"correction_of","required":false,"type":"string"}],"id_field":"rework_id"}},"schema_name":"spec-kit-aee lifecycle ledger schema","schema_version":1}